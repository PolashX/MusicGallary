[Unit]
Description=Cloud Music Gallery
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/music-gallery
EnvironmentFile=/home/ubuntu/music-gallery/.env
ExecStart=/home/ubuntu/music-gallery/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 --timeout 120 app:app
Restart=always

[Install]
WantedBy=multi-user.target
